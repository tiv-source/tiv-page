<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE validators PUBLIC "-//Apache Struts//XWork Validator 1.0.3//EN"
        "http://struts.apache.org/dtds/xwork-validator-1.0.3.dtd">

<validators>

  <field name="event.image">
    <field-validator type="required" short-circuit="true">
      <message key="event.image.validation.required" />
    </field-validator>
  </field>

  <field name="event.location">
    <field-validator type="required" short-circuit="true">
      <message key="event.location.validation.required" />
    </field-validator>
  </field>

  <field name="event.descriptionMap.DE.name">
    <field-validator type="requiredstring" short-circuit="true">
      <message key="event.descriptionMap.DE.name.validation.required" />
    </field-validator>
  </field>

  <field name="event.descriptionMap.DE.description">
    <field-validator type="requiredstring" short-circuit="true">
      <message key="event.descriptionMap.DE.description.validation.required" />
    </field-validator>
  </field>

  <field name="event.descriptionMap.DE.keywords">
    <field-validator type="requiredstring" short-circuit="true">
      <message key="event.descriptionMap.DE.keywords.validation.required" />
    </field-validator>
  </field>
  
</validators>